  - m_Id: 2262749212
    m_Localized: "\uC120\uD6C4\uACF5 \uC815\uD558\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 2262749213
    m_Localized: "\uD45C\uC801\uC5D0 \uAC00\uAE4C\uC6B4 \uCABD\uC774 \uD6C4\uACF5"
    m_Metadata:
      m_Items: []
  - m_Id: 2262749214
    m_Localized: "\uD558\uC6B0\uC2A4 \uC548\uC5D0 \uB9E4\uBC88 \uB2E4\uB978 \uC790\uB9AC\uC5D0
      \uD45C\uC801\uC774 \uC0DD\uAE41\uB2C8\uB2E4. \uAC01\uC790 \uC54C \uD558\uB098\uB97C
      \uD45C\uC801\uC5D0 \uCD5C\uB300\uD55C \uAC00\uAE5D\uAC8C \uAD74\uB9AC\uACE0,
      \uB354 \uAC00\uAE4C\uC6B4 \uCABD\uC774 1\uC5D4\uB4DC\uC758 \uD6C4\uACF5(\uB9C8\uC9C0\uB9C9
      \uC0F7)\uC774 \uB429\uB2C8\uB2E4. \uCD5C\uC18C \uB77C\uC778\uC5D0 \uBABB \uBBF8\uCE58\uAC70\uB098
      \uBC31 \uB77C\uC778\uC744 \uB118\uC73C\uBA74 \uAE30\uB85D\uC774 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2262749215
    m_Localized: "{name}\uBD80\uD130 \uAD74\uB9AC\uAE30"
    m_Metadata:
      m_Items:
      - rid: 4297768082125881572
  - m_Id: 2262749216
    m_Localized: "\uC120\uD6C4\uACF5 \uC815\uD558\uAE30 \uACB0\uACFC"
    m_Metadata:
      m_Items: []
  - m_Id: 2262749217
    m_Localized: "{name} \uD6C4\uACF5"
    m_Metadata:
      m_Items:
      - rid: 4297768082125881572
  - m_Id: 2262749218
    m_Localized: "\uB450 \uAE30\uB85D\uC774 \uAC19\uC544 \uB3D9\uC804 \uB358\uC9C0\uAE30\uB85C
      \uC815\uD588\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2262749219
    m_Localized: "\uD45C\uC801\uC5D0 \uB354 \uAC00\uAE4C\uC6B4 {name}\uC774 1\uC5D4\uB4DC\uC758
      \uB9C8\uC9C0\uB9C9 \uC0F7\uC744 \uAC00\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 4297768082125881572
  - m_Id: 2262749220
    m_Localized: "\uCD5C\uC18C \uB77C\uC778\uC5D0 \uBABB \uBBF8\uCCE4\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2262749221
    m_Localized: "\uD310 \uBC16\uC73C\uB85C \uB098\uAC14\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2262749222
    m_Localized: "{name}\uC774 \uBA3C\uC800 \uC3E9\uB2C8\uB2E4."
    m_Metadata:
      m_Items:
      - rid: 4297768082125881572
