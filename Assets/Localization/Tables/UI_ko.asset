      m_Items: []
  - m_Id: 1066247632375813
    m_Localized: "\uC11C\uBC84\uC5D0 \uC5F0\uACB0\uD558\uC9C0 \uBABB\uD588\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1066247632375814
    m_Localized: "\uC774 \uAE30\uAE30\uC5D0\uC11C\uB294 Google \uB85C\uADF8\uC778\uC744
      \uC4F8 \uC218 \uC5C6\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1066247632375815
    m_Localized: "Google \uC5F0\uB3D9\uC5D0 \uC2E4\uD328\uD588\uC5B4\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 1099965122138112
    m_Localized: "\uAE30\uB85D \uC120\uD0DD"
    m_Metadata:
      m_Items: []
  - m_Id: 1099965122138113
    m_Localized: "\uC774 Google \uACC4\uC815\uC5D0\uB294 \uC774\uBBF8 \uAC8C\uC784
      \uAE30\uB85D\uC774 \uC788\uC5B4\uC694.\n\uC5B4\uB290 \uAE30\uB85D\uC73C\uB85C
      \uD50C\uB808\uC774\uD560\uAE4C\uC694?"
    m_Metadata:
      m_Items: []
  - m_Id: 1099965122138114
    m_Localized: "Google \uACC4\uC815\uC758 \uAE30\uB85D"
