    m_Localized: "\uB2E4\uC74C \uC5D4\uB4DC \uD6C4\uACF5: {name} (\uC810\uC218\uB97C
      \uB0B4\uC9C0 \uBABB\uD55C \uCABD). \uD569\uACC4 {score}"
