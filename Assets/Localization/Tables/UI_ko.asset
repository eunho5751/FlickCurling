  - m_Id: 2262749184
    m_Localized: "AI \uAD00\uC804 \xB7 {b} {lb} vs {w} {lw}"
    m_Metadata:
      m_Items:
      - rid: 4297768082125881572
  - m_Id: 2262749185
    m_Localized: "Unity \uC774\uC2DD\uD310 \xB7 \uB8F0\uACFC \uC190\uB9DB \uAC80\uC99D\uC6A9"
    m_Metadata:
      m_Items: []
  - m_Id: 2262749186
    m_Localized: "\uC54C\uAE4C\uAE30 \uCEEC\uB9C1"
    m_Metadata:
      m_Items: []
  - m_Id: 2262749187
    m_Localized: "\uBC14\uB451\uC54C\uC744 \uD295\uACA8 \uC0C1\uB300 \uC54C\uC740
      \uCCD0\uB0B4\uACE0 \uB0B4 \uC54C\uB9CC \uC911\uC559\uC5D0 \uB0A8\uAE30\uC138\uC694.
      4\uC5D4\uB4DC, \uC5D4\uB4DC\uB2F9 10\uC0F7(1\uC778\uB2F9 \uC54C 5\uAC1C)\uC774\uBA70
      \uC911\uC559\uC5D0 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uCABD\uB9CC \uB4DD\uC810\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2262749188
    m_Localized: "\uCD5C\uC18C \uB77C\uC778\uC744 \uB118\uC9C0 \uBABB\uD558\uAC70\uB098
      \uBC31 \uB77C\uC778\uC744 \uB118\uC5B4\uAC04 \uC54C\uC740 \uBB34\uD6A8\uC785\uB2C8\uB2E4.
      \uCE21\uBCBD \uCFE0\uC158\uC740 \uD5C8\uC6A9\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 2262749189
    m_Localized: "\uBAA8\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 2262749190
    m_Localized: "\uAD00\uC804\uD560 AI \uB09C\uC774\uB3C4"
