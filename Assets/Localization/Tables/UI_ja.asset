  - m_Id: 4566859292528646
    m_Localized: "\u2022<indent=1em>\u30A8\u30F3\u30C9\u304C\u59CB\u307E\u308B\u3068\u3001\u5148\u653B\u306F\u30CF\u30A6\u30B9\u306E\u524D\u306B\u30DC\u30FC\u30CA\u30B9\u30AC\u30FC\u30C9\u306E\u77F3\u30921\u500B\u7F6E\u3044\u3066\u30B9\u30BF\u30FC\u30C8\u3057\u307E\u3059\u3002</indent>\n\u2022<indent=1em>\u5148\u653B\u304B\u3089\u9ED2\u3068\u767D\u304C1\u500B\u305A\u3064\u4EA4\u4E92\u306B{shots}\u500B\u305A\u3064\u6295\u3052\u3001\u6700\u5F8C\u306E\u77F3\u306F\u5F8C\u653B\u304C\u6295\u3052\u307E\u3059\u3002</indent>\n\u2022<indent=1em>\u6BCE\u56DE{seconds}\u79D2\u4EE5\u5185\u306B\u6295\u3052\u308B\u5FC5\u8981\u304C\u3042\u308A\u307E\u3059\u3002\u6700\u5C0F\u30E9\u30A4\u30F3\u306E\u4E0A\u306E\u5C0E\u706B\u7DDA\u304C\u71C3\u3048\u5C3D\u304D\u308B\u3068\u305D\u306E\u77F3\u3092\u5931\u3044\u307E\u3059\u3002</indent>"
