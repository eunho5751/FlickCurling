  - m_Id: 2262749184
    m_Localized: "Watch AI \xB7 {b} {lb} vs {w} {lw}"
    m_Metadata:
      m_Items:
      - rid: 4297768082125881571
  - m_Id: 2262749185
    m_Localized: "Unity port \xB7 testing the rules and feel"
    m_Metadata:
      m_Items: []
  - m_Id: 2262749186
    m_Localized: Flick Curling
    m_Metadata:
      m_Items: []
  - m_Id: 2262749187
    m_Localized: Flick go stones to knock your opponent's out and leave only yours
      in the middle. Four ends of 10 shots (5 stones each); only the side closest
      to the centre scores.
    m_Metadata:
      m_Items: []
  - m_Id: 2262749188
    m_Localized: A stone that stops short of the min line or goes past the back line
      doesn't count. Banking off the side rails is allowed.
    m_Metadata:
      m_Items: []
  - m_Id: 2262749189
    m_Localized: MODE
    m_Metadata:
      m_Items: []
