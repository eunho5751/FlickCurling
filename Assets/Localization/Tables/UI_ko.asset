      m_Items: []
  - m_Id: 1152180562087936
    m_Localized: "\uB2C9\uB124\uC784 \uC124\uC815"
    m_Metadata:
      m_Items: []
  - m_Id: 1152180608225280
    m_Localized: "\uAC8C\uC784\uC5D0\uC11C \uC0AC\uC6A9\uD560 \uB2C9\uB124\uC784\uC744
      \uC815\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 1152180608225281
    m_Localized: "\uB2C9\uB124\uC784 \uC785\uB825"
    m_Metadata:
      m_Items: []
  - m_Id: 1152180608225282
    m_Localized: "3~12\uC790, \uD55C\uAE00\xB7\uC601\uBB38\xB7\uC22B\uC790\uB9CC
      \uC4F8 \uC218 \uC788\uC5B4\uC694\n(\uD2B9\uC218\uBB38\uC790, \uC774\uBAA8\uC9C0,
      \uACF5\uBC31 \uBD88\uAC00)"
    m_Metadata:
      m_Items: []
  - m_Id: 1152180608225283
    m_Localized: "\uD655\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 1152180608225284
    m_Localized: "\uB2C9\uB124\uC784\uC744 \uC800\uC7A5\uD558\uC9C0 \uBABB\uD588\uC5B4\uC694.
      \uB2E4\uC2DC \uC2DC\uB3C4\uD574 \uC8FC\uC138\uC694."
